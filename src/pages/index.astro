---
import Base from '../layouts/Base.astro';
---
<Base title="Software Engineer">
  <div class="wrap hero">
    <div>
      <div class="eyebrow">Software engineering · Education · Practical systems</div>
      <h1>Good software starts with understanding.</h1>
      <p>I'm John Cole, a software engineer based in Phoenix. For more than 15 years, I've built applications that businesses depend on. I'm also working toward teaching software development, connecting programming fundamentals with the problems engineers encounter in practice.</p>
      <div class="actions">
        <a class="button" href="/work">Explore my work</a>
        <a class="textlink" href="/teaching">Teaching & education</a>
      </div>
    </div>
    <aside class="heroaside">
      <strong>What I work on</strong>
      Application architecture, databases, integrations, and the practical decisions behind reliable software.
      <br/><br/>
      <strong>What I'm exploring</strong>
      College instruction, human-directed software engineering, and independent products grounded in applied research.
    </aside>
  </div>

  <section class="band">
    <div class="wrap">
      <div class="sectionhead">
        <div>
          <div class="eyebrow">Selected work</div>
          <h2>Systems built for real problems.</h2>
        </div>
        <a class="textlink" href="/work">All projects</a>
      </div>
      <div class="grid">
        <article class="project">
          <div>
            <span class="number">01 / OPERATIONS</span>
            <h3>Warehouse & Inventory Operations Platform</h3>
            <p>Modernizing inventory, warehouse, and device-processing workflows, with integrations across external systems and hardware.</p>
          </div>
          <div class="tech">Ruby on Rails · REST APIs · Data modeling · Integrations</div>
        </article>
        <article class="project">
          <div>
            <span class="number">02 / AUCTIONS</span>
            <h3>Auction & Bidding Operations Platform</h3>
            <p>Software for auction and bidding operations, background processing, and operational reporting.</p>
          </div>
          <div class="tech">Ruby on Rails · PostgreSQL · Hotwire · Background jobs</div>
        </article>
        <article class="project">
          <div>
            <span class="number">03 / ANALYTICS</span>
            <h3>94x50</h3>
            <p>An independent basketball analytics product focused on team performance, trajectory, and comparative intelligence across a season.</p>
            <p><a class="textlink" href="https://94x50.io/" target="_blank" rel="noopener noreferrer">Visit 94x50</a></p>
          </div>
          <div class="tech">Independent product development</div>
        </article>
        <article class="project">
          <div>
            <span class="number">04 / RESEARCH & PUBLISHING</span>
            <h3>Versarium</h3>
            <p>An independent platform for scholarly research and knowledge sharing, with long-term product and community development.</p>
            <p><a class="textlink" href="https://versarium.app/" target="_blank" rel="noopener noreferrer">Visit Versarium</a></p>
          </div>
          <div class="tech">Independent product development</div>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="sectionhead">
        <div>
          <div class="eyebrow">Beyond the code</div>
          <h2>Building, explaining, teaching.</h2>
        </div>
      </div>
      <div class="three">
        <article>
          <h3>Software engineering</h3>
          <p>Designing and maintaining production applications, working with clients, and solving problems that don't fit neatly into a tutorial.</p>
          <a class="textlink" href="/work">Selected projects</a>
        </article>
        <article>
          <h3>Teaching & HDSE</h3>
          <p>Developing a practical approach to college-level instruction, including how engineers can use AI while retaining responsibility for understanding and decisions.</p>
          <a class="textlink" href="/teaching">Teaching interests</a>
        </article>
        <article>
          <h3>Independent products</h3>
          <p>Building applied research and product experiments — analytics, scholarly tools, and small practical applications — alongside client work.</p>
          <a class="textlink" href="/work">View products</a>
        </article>
      </div>
    </div>
  </section>
</Base>
