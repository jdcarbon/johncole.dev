---
import Base from '../layouts/Base.astro';

const professional = [
  {
    title: 'Warehouse & Inventory Operations Platform',
    kind: 'Operations',
    body: 'A custom application that supports inventory, device processing, and daily warehouse operations. Much of my work involves replacing legacy functionality, improving database performance, and connecting the system to external services and warehouse hardware. Because the application supports ongoing operations, changes have to be made without disrupting the people who use it.',
    tech: 'Ruby on Rails · REST APIs · Database design · Systems integration',
  },
  {
    title: 'Auction & Bidding Operations Platform',
    kind: 'Auctions',
    body: 'Software that runs auction and bidding operations end to end—cataloging lots, processing bids, and producing the reports operators rely on. I build and maintain the workflows, background jobs, and integrations that keep those processes reliable as business rules change.',
    tech: 'Ruby on Rails · PostgreSQL · REST APIs · Background jobs · Hotwire · Stimulus',
  },
  {
    title: 'Customer Engagement & Promotions Platform',
    kind: 'Engagement',
    body: 'A multi-component platform for customer engagement and promotional campaigns, with services and frontends that have to stay in sync. I contributed across several of those components—APIs, application code, and interfaces—working within a larger engineering organization.',
    tech: 'Ruby on Rails · Python · Go · Vue · REST APIs',
  },
  {
    title: 'Content Production & Workflow Platform',
    kind: 'Content systems',
    body: 'An established content-creation application where I handled framework upgrades, feature work, API development, and coordination of implementation across the team.',
    tech: 'Laravel · PHP · React · REST APIs · PostgreSQL',
  },
];

const independent = [
  {
    title: 'Versarium',
    kind: 'Research & publishing',
    body: 'A platform for scholarly publishing and research, with an emphasis on Latter-day Saint studies and room for broader academic work. Users can organize scholarly content, share knowledge, and participate through membership and community features. Long-term product and platform development are part of the work.',
    tech: 'Independent product development',
    url: 'https://versarium.app/',
  },
  {
    title: '94x50',
    kind: 'Basketball analytics',
    body: "An NBA analytics project built around a simple question: how does a team's performance change over a season, and what explains those changes? I'm developing tools for comparing teams, examining schedule difficulty, tracking performance trends, and understanding player contributions.",
    tech: 'Independent product development',
    url: 'https://94x50.io/',
  },
  {
    title: 'Register',
    kind: 'Subscription management',
    body: 'A SaaS application for teams that need a clear view of recurring software subscriptions—what they cost, when they renew, and who owns them. Built with Laravel; includes renewal reminders, reporting, and CSV export.',
    tech: 'Laravel',
  },
  {
    title: 'ChurchApps',
    kind: 'Church administration',
    body: 'Small applications that reduce recurring administrative work for local church organizations. One example generates sacrament meeting agendas; others automate similar routine workflows. Built and hosted with Ruby on Rails.',
    tech: 'Ruby on Rails',
  },
];
---
<Base title="Selected Work">
  <section class="wrap pagehero">
    <div class="eyebrow">Selected projects</div>
    <h1>Software for the way people work.</h1>
    <p>Examples of systems I've helped build and maintain — client applications and independent products. Most client work involves private business applications, so these summaries focus on the problems and technology rather than confidential details.</p>
  </section>

  <section class="wrap section section-tight">
    <div class="sectionhead">
      <div>
        <div class="eyebrow">Client / professional work</div>
        <h2>Systems for operational work.</h2>
      </div>
    </div>
    <div class="grid">
      {professional.map((p, i) => (
        <article class="project">
          <div>
            <span class="number">{String(i + 1).padStart(2, '0')} / {p.kind.toUpperCase()}</span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </div>
          <div class="tech">{p.tech}</div>
        </article>
      ))}
    </div>
  </section>

  <section class="wrap section section-tight">
    <div class="sectionhead">
      <div>
        <div class="eyebrow">Independent products</div>
        <h2>Products in development.</h2>
      </div>
    </div>
    <div class="grid">
      {independent.map((p, i) => (
        <article class="project">
          <div>
            <span class="number">{String(professional.length + i + 1).padStart(2, '0')} / {p.kind.toUpperCase()}</span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
            {p.url && <p><a class="textlink" href={p.url} target="_blank" rel="noopener noreferrer">Visit {p.title}</a></p>}
          </div>
          <div class="tech">{p.tech}</div>
        </article>
      ))}
    </div>
  </section>
</Base>
