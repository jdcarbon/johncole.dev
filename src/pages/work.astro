---
import Base from '../layouts/Base.astro';
const projects=[
{title:'PLAT',kind:'Inventory and warehouse operations',body:'Developing and modernizing business-critical applications for inventory, warehouse operations, and device processing. The work includes external integrations, operational workflows, and maintaining systems people rely on every day.',tech:'Ruby on Rails · REST APIs · Database design · Systems integration'},
{title:'BDI',kind:'Auction and bidding operations',body:'Building and maintaining an application for auction workflows, bidding operations, background processing, and reporting. A substantial part of the work involves keeping asynchronous processes reliable and making operational information usable.',tech:'Ruby on Rails · PostgreSQL · REST APIs · Background jobs · Hotwire · Stimulus'},
{title:'Hownd',kind:'Promotional marketplace',body:'Contributed to a Groupon-style promotional platform spanning several services and frontend applications. Worked across languages and teams within an established production system.',tech:'Ruby on Rails · Python · Go · Vue · REST APIs'},
{title:'Content creation platform',kind:'Application modernization and team leadership',body:'Led development work on an established content-creation application, including framework upgrades, feature development, and coordination of implementation across the team.',tech:'Laravel · PHP · React · REST APIs · PostgreSQL'}];
---
<Base title="Selected Work"><section class="wrap pagehero"><div class="eyebrow">Selected projects</div><h1>Software for the way people work.</h1><p>A few examples of systems I've helped build and maintain. Most are private business applications, so these summaries focus on the problems and technology rather than confidential details.</p></section><section class="wrap section" style="padding-top:0"><div class="grid">{projects.map((p,i)=><article class="project"><div><span class="number">{String(i+1).padStart(2,'0')} / {p.kind.toUpperCase()}</span><h3>{p.title}</h3><p>{p.body}</p></div><div class="tech">{p.tech}</div></article>)}</div></section></Base>
