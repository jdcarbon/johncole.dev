---
import Base from '../layouts/Base.astro';

const professional = [
  {
    title: 'Warehouse & Inventory Operations Platform',
    kind: 'Operations',
    body: 'A custom business-critical application supporting inventory, warehouse operations, device processing, and operational workflows. Work has included modernizing legacy functionality, Ruby on Rails development, database architecture and performance, integrations with external systems and hardware, and supporting a production application with substantial operational dependencies.',
    tech: 'Ruby on Rails · REST APIs · Database design · Systems integration',
  },
  {
    title: 'Auction & Bidding Operations Platform',
    kind: 'Auctions',
    body: 'A custom operational application supporting auction workflows, bidding, business processes, and reporting. Built with Ruby on Rails and PostgreSQL, with complex business rules, background processing, APIs and external integrations, and operational reporting and analytics.',
    tech: 'Ruby on Rails · PostgreSQL · REST APIs · Background jobs · Hotwire · Stimulus',
  },
  {
    title: 'Customer Engagement & Promotions Platform',
    kind: 'Engagement',
    body: 'A multi-component software platform supporting customer engagement and promotional campaigns. Work spanned Ruby on Rails, Python, Vue, and Go-based APIs, with integration across multiple application components and collaboration within a larger engineering organization.',
    tech: 'Ruby on Rails · Python · Go · Vue · REST APIs',
  },
  {
    title: 'Content Production & Workflow Platform',
    kind: 'Content systems',
    body: 'Development work on an established content-creation application, including framework upgrades, feature development, API work, and coordination of implementation across the team.',
    tech: 'Laravel · PHP · React · REST APIs · PostgreSQL',
  },
];

const independent = [
  {
    title: 'Versarium',
    kind: 'Research & publishing',
    body: 'An independent software product supporting serious scholarship, research, and knowledge sharing, with an emphasis on Latter-day Saint studies while accommodating broader academic interests. Focused on building a specialized publishing and research platform, supporting scholarly content and knowledge organization, membership and community functionality, and long-term product development and platform strategy. Ongoing independent project.',
    tech: 'Independent product development',
  },
  {
    title: '94x50',
    kind: 'Basketball analytics',
    body: "An independent basketball analytics product focused on understanding how teams perform, evolve, and compare throughout a season. Development work includes NBA statistical data ingestion and aggregation, team performance analysis, historical trends and time-series comparisons, schedule-strength analysis, player roles and contributions, interactive data visualization, automated insight generation, and statistical validation and testing. The goal is analytics that communicate not only a team's current performance, but how it arrived there and where its trajectory may be heading. Active product development.",
    tech: 'Independent product development',
  },
  {
    title: 'Register',
    kind: 'Subscription management',
    body: 'An independently developed SaaS application for tracking recurring business subscriptions and renewal obligations. Functionality includes subscription and renewal tracking, team-based organization, recurring expense visibility, upcoming renewal notifications and reporting, and CSV exports, along with SaaS product architecture and subscription billing development.',
    tech: 'Laravel',
  },
  {
    title: 'ChurchApps',
    kind: 'Church administration',
    body: 'A collection of lightweight applications designed to simplify recurring administrative work for local church organizations. Work includes custom workflow automation, sacrament meeting agenda generation, Ruby on Rails development, deployment and hosting, and practical user-focused application design. A small independent software initiative.',
    tech: 'Ruby on Rails',
  },
];
---
<Base title="Selected Work">
  <section class="wrap pagehero">
    <div class="eyebrow">Selected projects</div>
    <h1>Software for the way people work.</h1>
    <p>Examples of systems I've helped build and maintain — client applications and independent products. Most client work involves private business applications, so these summaries focus on the problems and technology rather than confidential details.</p>
  </section>

  <section class="wrap section" style="padding-top:0">
    <div class="sectionhead">
      <div>
        <div class="eyebrow">Client / professional work</div>
        <h2>Systems for operational work.</h2>
      </div>
    </div>
    <div class="grid">
      {professional.map((p, i) => (
        <article class="project">
          <div>
            <span class="number">{String(i + 1).padStart(2, '0')} / {p.kind.toUpperCase()}</span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </div>
          <div class="tech">{p.tech}</div>
        </article>
      ))}
    </div>
  </section>

  <section class="wrap section" style="padding-top:0">
    <div class="sectionhead">
      <div>
        <div class="eyebrow">Independent products</div>
        <h2>Products in development.</h2>
      </div>
    </div>
    <div class="grid">
      {independent.map((p, i) => (
        <article class="project">
          <div>
            <span class="number">{String(professional.length + i + 1).padStart(2, '0')} / {p.kind.toUpperCase()}</span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </div>
          <div class="tech">{p.tech}</div>
        </article>
      ))}
    </div>
  </section>
</Base>
