---
import Base from '../layouts/Base.astro';

const principles = [
  {
    num: '01',
    title: 'Humans Direct, Humans Remain Accountable',
    body: 'Humans own requirements, priorities, constraints, acceptance decisions, and deployment responsibility. Delegation of implementation is not delegation of accountability. An assistant can draft a change; a person still owns whether it ships and what happens afterward.',
    practice: 'Before merging AI-assisted work, name the accountable reviewer and the acceptance criteria that person will use.',
  },
  {
    num: '02',
    title: 'The Repository Is the Source of Truth',
    body: 'The project repository should contain durable, inspectable artifacts representing the state of the system: requirements, architectural decisions, contracts and interfaces, implementation, tests, relevant documentation, and build and verification procedures. A chat transcript should not be the only location of a critical design decision.',
    practice: 'When a decision matters later, write it into the repo—an ADR, a README note, a contract test—before the conversation ends.',
  },
  {
    num: '03',
    title: 'Specify Outcomes Before Delegating Implementation',
    body: 'Define intended behavior, constraints, and acceptance criteria before asking an assistant or agent to implement a feature. Specifications should be proportional to the task. A one-line rename does not need a design document; a data import path that can corrupt records does.',
    practice: 'For non-trivial work, state inputs, outputs, failure modes, and “done” conditions in the issue or PR before prompting for code.',
  },
  {
    num: '04',
    title: 'Verify Independently',
    body: 'AI output must be checked against evidence beyond the model’s own claim that it is correct. Useful checks include automated tests, static analysis, type checking, contract validation, security review, runtime observation, and manual inspection against acceptance criteria. Tests written by the same model that wrote the code can help, but they are not automatically independent if they share the same assumptions.',
    practice: 'Treat “the assistant said it works” as a claim to check. Prefer checks that can fail when the claim is wrong.',
  },
  {
    num: '05',
    title: 'Design for Model and Session Independence',
    body: 'A project must remain understandable and maintainable when the original model, coding agent, conversation, or tool is unavailable. Model-specific instructions may exist, but critical project knowledge should not be locked into a proprietary conversation. Durable artifacts provide continuity across people and tools.',
    practice: 'Ask whether a competent engineer joining next quarter could reconstruct intent from the repository alone.',
  },
  {
    num: '06',
    title: 'Preserve and Exercise Engineering Judgment',
    body: 'The engineer must maintain the ability to understand failures, evaluate alternatives, recognize risk, and challenge generated results. The methodology should increase engineering leverage without gradually making the human incapable of directing the system.',
    practice: 'Periodically implement or debug a path without assistance—enough to keep diagnosis and design muscles working.',
  },
];

const workflow = [
  {
    num: '01',
    title: 'Define',
    body: 'Determine the problem, intended outcome, and relevant constraints. Clarify what is in scope and what is not.',
  },
  {
    num: '02',
    title: 'Specify',
    body: 'Establish observable behavior, contracts, success criteria, and relevant risks. Keep the level of ceremony proportional to the change.',
  },
  {
    num: '03',
    title: 'Delegate and Implement',
    body: 'Choose appropriate work for human implementation, AI assistance, or automated agents. Implementation is directed work, not unsupervised generation.',
  },
  {
    num: '04',
    title: 'Verify',
    body: 'Evaluate actual outputs through tests, inspection, and other evidence. Verification should continue throughout the change, not only after a large batch of code appears.',
  },
  {
    num: '05',
    title: 'Integrate',
    body: 'Ensure the change works within the surrounding system, respects architecture, and does not introduce regressions.',
  },
  {
    num: '06',
    title: 'Review and Preserve',
    body: 'Capture decisions, update documentation, and leave the repository understandable to the next engineer or agent.',
  },
];

const paths = [
  {
    title: 'Builder',
    body: 'Practical engineering workflows for developers who want to use AI assistants responsibly and productively—specification habits, review checklists, and verification patterns that fit day-to-day delivery.',
  },
  {
    title: 'Deeper Understanding',
    body: 'Architecture, systems thinking, programming fundamentals, verification, and the reasoning necessary to evaluate generated software when the first draft is no longer the scarce resource.',
  },
  {
    title: 'Curriculum Builder',
    body: 'Materials for instructors who want to adapt software engineering education to AI-assisted development without abandoning foundational knowledge. Connected to, but not limited by, classroom use.',
  },
];

const reading = [
  {
    title: 'ACM/IEEE-CS/AAAI — Computer Science Curricula 2023',
    href: 'https://csed.acm.org/',
    note: 'Curriculum guidance for undergraduate computer science programs.',
  },
  {
    title: 'Google Cloud — 2025 DORA AI Capabilities Model',
    href: 'https://cloud.google.com/resources/content/2025-dora-ai-capabilities-model-report',
    note: 'Industry research on AI capabilities in software delivery organizations.',
  },
  {
    title: 'GitHub — Repository custom instructions',
    href: 'https://docs.github.com/en/copilot/concepts/prompting-and-context/custom-instructions',
    note: 'How project-level instructions can keep durable context in the repository.',
  },
  {
    title: 'METR — Measuring the Impact of Early-2025 AI on Experienced Open-Source Developer Productivity',
    href: 'https://metr.org/blog/2025-07-10-early-2025-ai-experienced-os-dev-study/',
    note: 'Empirical study of AI assistance and experienced developer productivity.',
  },
  {
    title: 'NIST — AI Risk Management Framework: Generative AI Profile',
    href: 'https://www.nist.gov/publications/artificial-intelligence-risk-management-framework-generative-artificial-intelligence',
    note: 'Risk-management guidance for generative AI systems and uses.',
  },
