---
import '../styles/global.css';
interface Props { title: string; description?: string; }
const {title, description='John Cole — software engineering, teaching, and practical approaches to building software.'} = Astro.props;
const path=Astro.url.pathname;
const nav=[['/','Home'],['/work','Work'],['/teaching','Teaching'],['/hdse','HDSE'],['/about','About']];
const isCurrent = (href: string) =>
  path === href || (href !== '/' && (path === href.replace(/\/$/, '') || path.startsWith(href.endsWith('/') ? href : href + '/')));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <meta name="theme-color" content="#F8F7F2"/>
  <meta name="description" content={description}/>
  <meta property="og:title" content={`${title} | John Cole`}/>
  <meta property="og:description" content={description}/>
  <meta property="og:type" content="website"/>
  <meta property="og:url" content={new URL(path, Astro.site).href}/>
  <link rel="canonical" href={new URL(path, Astro.site)}/>
  <link rel="icon" href="/favicon.svg?v=jc2" type="image/svg+xml"/>
  <link rel="icon" href="/favicon.ico?v=jc2" sizes="any"/>
  <title>{title} | John Cole</title>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="nav">
    <div class="wrap navinner">
      <a class="logo" href="/">johncole<span class="logo-dot">.</span>dev</a>

      <nav class="navpanel navpanel-desktop" aria-label="Main navigation">
        {nav.map(([href, label]) => (
          <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>
        ))}
        <a class="navcta" href="mailto:colejd@gmail.com">Get in touch</a>
      </nav>

      <details class="navmenu">
        <summary class="navtoggle">
          <span class="navtoggle-label">Menu</span>
        </summary>
        <nav class="navpanel navpanel-mobile" aria-label="Main navigation">
          {nav.map(([href, label]) => (
            <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>
          ))}
          <a class="navcta" href="mailto:colejd@gmail.com">Get in touch</a>
        </nav>
      </details>
    </div>
  </header>
  <main id="main">
    <slot />
  </main>
  <footer class="footer">
    <div class="wrap footinner">
      <span>© {new Date().getFullYear()} John Cole · Phoenix, Arizona</span>
      <div class="footlinks">
        <a href="mailto:colejd@gmail.com">Email</a>
        <a href="/teaching">Teaching</a>
        <a href="/work">Selected work</a>
      </div>
    </div>
  </footer>
</body>
</html>
